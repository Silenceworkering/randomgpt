BOT_TOKEN=
DATABASE_URL=postgresql+asyncpg://dedlainych:CHANGE_ME@db:5432/dedlainych
POSTGRES_PASSWORD=CHANGE_ME
ADMIN_IDS=[]
AI_PROVIDER=rules
AI_API_KEY=
AI_BASE_URL=http://ollama:11434
AI_MODEL=qwen2.5:7b
TZ=Asia/Yakutsk
GROUP_CODE=6104-ОБ
MAX_FILE_BYTES=10485760

# Render sets 180 to wait for the previous worker during a deploy.
INSTANCE_LOCK_WAIT_SECONDS=0

# Free Render uses webhook. Keep polling for local Docker startup.
RUN_MODE=polling
WEBHOOK_SECRET=
WEBHOOK_BASE_URL=
PORT=10000

# Optional semantic analysis. Defaults make NO external API requests.
AI_EXTERNAL_ENABLED=false
AI_GROQ_MODEL=openai/gpt-oss-20b
AI_DAILY_REQUEST_LIMIT=100
AI_MAX_OUTPUT_TOKENS=1536
AI_TIMEOUT_SECONDS=20
CONTEXT_TTL_MINUTES=120
CONTEXT_MESSAGE_LIMIT=12

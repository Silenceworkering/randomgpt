# Необязательно: без токена работает только сайт.
TELEGRAM_BOT_TOKEN=
# Публичный HTTPS-адрес сервиса, без завершающего слеша.
PUBLIC_BASE_URL=https://voltrix.onrender.com
# 32–256 символов: A-Z a-z 0-9 _ -; сгенерируйте secrets.token_urlsafe(32).
TELEGRAM_WEBHOOK_SECRET=
PORT=8000
# Автообновление страниц магазинов при старте и раз в час. false — для локальных тестов.
PRICES_AUTO_REFRESH=true

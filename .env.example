BOT_TOKEN=
DATABASE_URL=postgresql+asyncpg://dedlainych:CHANGE_ME@db:5432/dedlainych
POSTGRES_PASSWORD=CHANGE_ME
ADMIN_IDS=[]
AI_PROVIDER=rules
AI_API_KEY=
AI_BASE_URL=http://ollama:11434
AI_MODEL=qwen2.5:7b
TZ=Asia/Yakutsk
